---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="ADHD Reflect home">
          <svg width="24" height="24" viewBox="0 0 64 64" fill="none">
            <line x1="4" y1="32" x2="60" y2="32" stroke="var(--blue)" stroke-width="1" stroke-opacity="0.25"/>
            <path d="M32 6 C32 6, 48 16, 48 29 C48 37.8 40.8 44 32 44 C23.2 44 16 37.8 16 29 C16 16 32 6 32 6Z" fill="var(--blue)"/>
            <path d="M32 58 C32 58, 48 48, 48 35 C48 26.2 40.8 20 32 20 C23.2 20 16 26.2 16 35 C16 48 32 58 32 58Z" fill="var(--sage)" opacity="0.75"/>
          </svg>
          <span>adhd reflect</span>
        </a>
        <p class="footer-tagline">For ADHD parents raising ADHD kids.<br/>Not therapy. Not advice. Just what helps.</p>
      </div>
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/legal/privacy">Privacy</a>
        <a href="/legal/terms">Terms</a>
        <a href="/legal/safety">Safety</a>
        <a href="/legal/cookies">Cookies</a>
        <a href="/legal/affiliate">Affiliate</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} ADHD Reflect. </p>
      <p>This is not medical advice. If you or your child are in crisis, <a href="/legal/safety">find support here</a>.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--mist-border);
    background: var(--cloud);
    padding: var(--space-2xl) 0;
    margin-top: auto;
  }
  .footer-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }
  .footer-brand {
    max-width: 320px;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--slate);
    margin-bottom: var(--space-sm);
  }
  .footer-tagline {
    font-size: 14px;
    line-height: 1.55;
    color: var(--pewter);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }
  .footer-links a {
    font-size: 13px;
    color: var(--pewter);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .footer-links a:hover {
    color: var(--slate);
  }
  .footer-bottom {
    border-top: 1px solid var(--mist-border);
    padding-top: var(--space-lg);
  }
  .footer-bottom p {
    font-size: 13px;
    color: var(--pewter);
    opacity: 0.7;
    line-height: 1.6;
  }
  .footer-bottom p + p {
    margin-top: var(--space-xs);
  }
  .footer-bottom a {
    color: var(--pewter);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
    }
    .footer-links {
      gap: var(--space-sm) var(--space-md);
    }
  }
</style>

