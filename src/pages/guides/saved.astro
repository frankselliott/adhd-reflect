---
import Base from '../../layouts/Base.astro';
import { TOPIC_GUIDES } from '../../data/topicGuides.js';
---
<Base title="Saved Guides" description="Your saved guides for later reading." current="saved">

  <section class="saved-hero">
    <div class="saved-inner">
      <p class="saved-label">Your reading list</p>
      <h1 class="saved-title">Saved <em>guides</em></h1>
      <p class="saved-body">Guides you've bookmarked from cards. Read them when you have the space to go deeper.</p>
    </div>
  </section>

  <div id="saved-root"></div>

  <script id="all-guides-data" type="application/json" set:html={JSON.stringify(TOPIC_GUIDES.map(g => ({
    id: g.id,
    title: g.title,
    topic: g.topic,
    recognize: g.recognize,
  })))} />

  <script>
    const allGuides = JSON.parse(document.getElementById('all-guides-data').textContent);
    const root = document.getElementById('saved-root');

    function render() {
      let saved = [];
      try { saved = JSON.parse(localStorage.getItem('adhd-reflect-saved-guides') || '[]'); } catch(e) {}

      if (saved.length === 0) {
        root.innerHTML = `
          <div style="max-width:640px;margin:0 auto;padding:40px 24px;text-align:center">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#A09589" stroke-width="1.5" style="margin-bottom:16px;opacity:0.4">
              <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
            </svg>
            <p style="font-family:var(--serif);font-size:18px;color:#6B6358;margin-bottom:8px">No saved guides yet</p>
            <p style="font-family:var(--serif);font-size:15px;color:#A09589;margin-bottom:24px">
              When you find a guide on a card, tap the bookmark icon to save it here.
            </p>
            <a href="/guides" style="
              display:inline-flex;align-items:center;gap:8px;
              padding:10px 24px;border-radius:100;
              background:var(--blue);color:white;
              text-decoration:none;font-family:var(--sans);font-size:15px;font-weight:600;
            ">Browse all guides</a>
          </div>
        `;
        return;
      }

      const guidesMap = Object.fromEntries(allGuides.map(g => [g.id, g]));
      const items = saved
        .map(s => ({ ...s, ...(guidesMap[s.id] || {}) }))
        .filter(s => s.title);

      root.innerHTML = `
        <div style="max-width:640px;margin:0 auto;padding:0 24px 80px">
          <div style="font-family:var(--mono);font-size:11px;letter-spacing:0.08em;color:#A09589;margin-bottom:16px">
            ${items.length} saved guide${items.length !== 1 ? 's' : ''}
          </div>
          ${items.map(g => `
            <div style="display:flex;align-items:center;gap:0;background:white;border-radius:14px;border:1px solid rgba(25,23,20,0.06);margin-bottom:10px;overflow:hidden">
              <a href="/guides/${g.id}" style="
                flex:1;padding:16px 18px;text-decoration:none;color:#191714;
              ">
                <span style="font-family:var(--mono);font-size:9px;letter-spacing:0.12em;color:#4B6B4E;text-transform:lowercase">${g.topic || ''}</span>
                <span style="display:block;font-family:var(--serif);font-size:16px;line-height:1.4;margin-top:4px">${g.title}</span>
              </a>
              <button onclick="removeGuide('${g.id}')" style="
                appearance:none;border:0;cursor:pointer;background:transparent;
                padding:16px;color:#B85038;flex-shrink:0;
              " title="Remove from saved">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#B85038" stroke="#B85038" stroke-width="1.5">
                  <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"/>
                </svg>
              </button>
            </div>
          `).join('')}
          <div style="margin-top:24px;text-align:center">
            <a href="/guides" style="
              font-family:var(--mono);font-size:12px;color:#A09589;text-decoration:none;
            ">browse all guides →</a>
          </div>
        </div>
      `;
    }

    window.removeGuide = function(id) {
      try {
        let list = JSON.parse(localStorage.getItem('adhd-reflect-saved-guides') || '[]');
        list = list.filter(g => g.id !== id);
        localStorage.setItem('adhd-reflect-saved-guides', JSON.stringify(list));
        render();
      } catch(e) {}
    };

    render();
  </script>

</Base>

<style>
  .saved-hero { padding: 64px 0 32px; }
  .saved-inner { max-width: 640px; margin: 0 auto; padding: 0 24px; }
  .saved-label {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em;
    text-transform: uppercase; color: #B85038; margin-bottom: 12px;
  }
  .saved-title {
    font-family: var(--serif); font-size: clamp(28px, 4vw, 40px); font-weight: 300;
    line-height: 1.15; color: #191714; margin-bottom: 16px;
  }
  .saved-title em { font-style: italic; color: #B85038; }
  .saved-body { font-size: 17px; line-height: 1.6; color: #6B6358; max-width: 480px; }
</style>

