---
import Base from '../../layouts/Base.astro';
import { TOPIC_GUIDES } from '../../data/topicGuides.js';
import { CARDS } from '../../data/cards.js';

export function getStaticPaths() {
  return TOPIC_GUIDES.map(guide => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const cardsMap = Object.fromEntries(CARDS.map(c => [c.id, c]));
const relatedCardTitles = (guide.relatedCards || [])
  .filter(id => cardsMap[id])
  .map(id => ({ id, title: cardsMap[id].title }));

// Strip inline markdown the same way the cards page does, but do NOT
// truncate: guides are long-form and the whole point is the full text being
// crawlable. Split each field into real paragraphs so the server-rendered
// article is proper headings and paragraphs, not one blob.
function stripMarkdown(s) {
  return String(s || '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')          // images
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')        // links -> text
    .replace(/`([^`]+)`/g, '$1')                    // inline code
    .replace(/[*_]{1,3}([^*_]+?)[*_]{1,3}/g, '$1')  // bold / italic -> text
    .replace(/^#{1,6}\s+/gm, '')                    // headings
    .replace(/^>\s?/gm, '')                         // blockquotes
    .trim();
}
function toParagraphs(s) {
  return String(s || '')
    .split(/\n\n+/)
    .map(b => stripMarkdown(b).replace(/\s+/g, ' ').trim())
    .filter(Boolean);
}
function inlineText(s) {
  return stripMarkdown(s).replace(/\s+/g, ' ').trim();
}

// AI answer engines cite short, self-contained passages. seoTitle is the
// natural-language question form used for the <title> and the FAQ question;
// the H1 (rendered by the guide viewer) keeps the brand-voice title. The
// answerBlock is server rendered as a quiet lead so it is crawlable and
// quotable even before the React viewer mounts.
const seoTitle = guide.seoTitle || `${guide.title} · Guide`;
const answerBlock = guide.answerBlock || '';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.title,
  "description": guide.recognize,
  "author": { "@type": "Organization", "name": "ADHD Reflect" },
  "publisher": { "@type": "Organization", "name": "ADHD Reflect", "url": "https://adhdreflect.com" },
  "mainEntityOfPage": `https://adhdreflect.com/guides/${guide.id}`
};
const faqSchema = answerBlock ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": guide.seoTitle || guide.title,
    "acceptedAnswer": { "@type": "Answer", "text": answerBlock }
  }]
} : null;
const pageSchema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---
<Base title={seoTitle} description={guide.recognize} schema={pageSchema}>

  {answerBlock && (
    <div class="guide-lead guide-prose">
      <p>{answerBlock}</p>
    </div>
  )}

  <!-- SEO: full server-rendered guide for crawlers (React renders over this) -->
  <article id="seo-content" class="seo-article">
    <h1>{guide.title}</h1>
    <p class="seo-type">{guide.topic}</p>
    {guide.recognize && <p>{guide.recognize}</p>}

    {guide.brain && (
      <section>
        <h2>What is happening in your brain</h2>
        {toParagraphs(guide.brain).map(p => <p>{p}</p>)}
      </section>
    )}
    {guide.kidBrain && (
      <section>
        <h2>What is happening in your child's brain</h2>
        {toParagraphs(guide.kidBrain).map(p => <p>{p}</p>)}
      </section>
    )}
    {guide.dualDynamic && (
      <section>
        <h2>The dual-ADHD dynamic</h2>
        {toParagraphs(guide.dualDynamic).map(p => <p>{p}</p>)}
      </section>
    )}
    {guide.strategies && guide.strategies.length > 0 && (
      <section>
        <h2>What actually works</h2>
        <ol>
          {guide.strategies.map(s => <li>{inlineText(s)}</li>)}
        </ol>
      </section>
    )}
    {guide.scripts && guide.scripts.length > 0 && (
      <section>
        <h2>Scripts</h2>
        {guide.scripts.map(sc => (
          <div>
            <h3>{sc.situation}</h3>
            <p>"{sc.say}"</p>
          </div>
        ))}
      </section>
    )}
    {guide.partner && (
      <section>
        <h2>What your partner needs to know</h2>
        {toParagraphs(guide.partner).map(p => <p>{p}</p>)}
      </section>
    )}
    {guide.moreHelp && (
      <section>
        <h2>When to get more help</h2>
        {toParagraphs(guide.moreHelp).map(p => <p>{p}</p>)}
      </section>
    )}
    {relatedCardTitles.length > 0 && (
      <section>
        <h2>Related in-the-moment cards</h2>
        <ul>
          {relatedCardTitles.map(c => <li><a href={`/cards/${c.id}`}>{c.title}</a></li>)}
        </ul>
      </section>
    )}
  </article>

  <div id="guide-root"></div>

  <script id="guide-data" type="application/json" set:html={JSON.stringify(guide)} />
  <script id="related-data" type="application/json" set:html={JSON.stringify(relatedCardTitles)} />

  <script>
    // Hide SEO content once React loads
    const seoEl = document.getElementById('seo-content');
    if (seoEl) seoEl.style.display = 'none';

    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import TopicGuideViewer from '../../components/TopicGuideViewer.jsx';

    const guide = JSON.parse(document.getElementById('guide-data').textContent);
    const relatedCardTitles = JSON.parse(document.getElementById('related-data').textContent);

    const root = createRoot(document.getElementById('guide-root'));
    root.render(createElement(TopicGuideViewer, { guide, relatedCardTitles }));
  </script>

</Base>

<style is:global>
  .seo-article {
    max-width: 640px; margin: 0 auto; padding: 40px 24px;
    font-family: var(--serif); color: #6B6358; line-height: 1.7;
  }
  .seo-article h1 { font-size: 28px; font-weight: 300; color: #191714; margin-bottom: 8px; }
  .seo-article h2 { font-size: 20px; font-weight: 400; color: #191714; margin-top: 24px; }
  .seo-article h3 { font-size: 16px; font-weight: 500; color: #4B6B4E; margin-top: 16px; }
  .seo-article p { margin-bottom: 12px; }
  .seo-type { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: #4A6FA5; text-transform: uppercase; }
  .guide-lead {
    max-width: 640px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }
  .guide-lead p {
    color: #8A8175;
    font-style: italic;
  }
  .guide-prose p {
    font-family: var(--serif);
    font-variation-settings: "opsz" 16, "wght" 400;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6358;
    margin-bottom: 16px;
    max-width: 60ch;
  }
  .guide-prose p:last-child { margin-bottom: 0; }
  .guide-prose strong { color: #191714; font-variation-settings: "opsz" 16, "wght" 600; }
  .guide-prose em { font-style: italic; color: #191714; }
</style>

