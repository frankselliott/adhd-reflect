---
import Base from '../../layouts/Base.astro';
import { TOPIC_GUIDES } from '../../data/topicGuides.js';
import { CARDS } from '../../data/cards.js';

export function getStaticPaths() {
  return TOPIC_GUIDES.map(guide => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const cardsMap = Object.fromEntries(CARDS.map(c => [c.id, c]));
const relatedCardTitles = (guide.relatedCards || [])
  .filter(id => cardsMap[id])
  .map(id => ({ id, title: cardsMap[id].title }));

// AI answer engines cite short, self-contained passages. seoTitle is the
// natural-language question form used for the <title> and the FAQ question;
// the H1 (rendered by the guide viewer) keeps the brand-voice title. The
// answerBlock is server rendered as a quiet lead so it is crawlable and
// quotable even before the React viewer mounts.
const seoTitle = guide.seoTitle || `${guide.title} · Guide`;
const answerBlock = guide.answerBlock || '';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.title,
  "description": guide.recognize,
  "author": { "@type": "Organization", "name": "ADHD Reflect" },
  "publisher": { "@type": "Organization", "name": "ADHD Reflect", "url": "https://adhdreflect.com" },
  "mainEntityOfPage": `https://adhdreflect.com/guides/${guide.id}`
};
const faqSchema = answerBlock ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": guide.seoTitle || guide.title,
    "acceptedAnswer": { "@type": "Answer", "text": answerBlock }
  }]
} : null;
const pageSchema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---
<Base title={seoTitle} description={guide.recognize} schema={pageSchema}>

  {answerBlock && (
    <div class="guide-lead guide-prose">
      <p>{answerBlock}</p>
    </div>
  )}

  <div id="guide-root"></div>

  <script id="guide-data" type="application/json" set:html={JSON.stringify(guide)} />
  <script id="related-data" type="application/json" set:html={JSON.stringify(relatedCardTitles)} />

  <script>
    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import TopicGuideViewer from '../../components/TopicGuideViewer.jsx';

    const guide = JSON.parse(document.getElementById('guide-data').textContent);
    const relatedCardTitles = JSON.parse(document.getElementById('related-data').textContent);

    const root = createRoot(document.getElementById('guide-root'));
    root.render(createElement(TopicGuideViewer, { guide, relatedCardTitles }));
  </script>

</Base>

<style is:global>
  .guide-lead {
    max-width: 640px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }
  .guide-lead p {
    color: #8A8175;
    font-style: italic;
  }
  .guide-prose p {
    font-family: var(--serif);
    font-variation-settings: "opsz" 16, "wght" 400;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6358;
    margin-bottom: 16px;
    max-width: 60ch;
  }
  .guide-prose p:last-child { margin-bottom: 0; }
  .guide-prose strong { color: #191714; font-variation-settings: "opsz" 16, "wght" 600; }
  .guide-prose em { font-style: italic; color: #191714; }
</style>

