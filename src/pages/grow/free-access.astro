---
import Base from '../../layouts/Base.astro';
---
<Base title="Setting up your access" description="Both of You free access" current="grow">
  <div style="max-width:480px;margin:0 auto;padding:80px 24px;text-align:center">
    <div id="status" style="font-family:var(--sans);font-size:16px;color:var(--pewter)">Setting up your access...</div>
  </div>
</Base>
<script>
  // This page used to redeem the code straight from the URL, which meant a code
  // entered at checkout never got the chance to capture an email and so had no
  // recovery path. It now forwards to /grow/redeem, the single redemption UI,
  // with the code prefilled. Nothing is spent here.
  (function () {
    var params = new URLSearchParams(window.location.search);
    var code = params.get('code') || '';
    var pattern = params.get('pattern') || '';
    if (pattern) {
      try { localStorage.setItem('adhd_pattern', pattern); } catch (e) { /* private mode */ }
    }
    var target = '/grow/redeem';
    if (code) target += '?code=' + encodeURIComponent(code);
    window.location.replace(target);
  })();
</script>