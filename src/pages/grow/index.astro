.section-recover {
  padding: var(--space-3xl) 0;
  background: var(--mist);
  border-top: 1px solid var(--mist-border);
  border-bottom: 1px solid var(--mist-border);
}
.recover-card {
  max-width: 480px;
  margin: 0 auto;
  text-align: center;
}
.recover-title {
  font-family: var(--sans);
  font-size: 15px;
  font-weight: 500;
