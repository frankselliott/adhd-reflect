}
.recover-body {
  font-family: var(--sans);
  font-size: 14px;
  color: var(--pewter);
  line-height: 1.6;
  margin-bottom: var(--space-lg);
}
.recover-form {
  display: flex;
  gap: 8px;
  max-width: 400px;
  margin: 0 auto var(--space-md);
}
.recover-input {
  flex: 1;
  padding: 12px 16px;
  font-family: var(--sans);
  font-size: 15px;
  color: var(--slate);
  background: white;
  border: 1.5px solid rgba(31,42,55,0.12);
  border-radius: var(--radius-md);
  outline: none;
  transition: border-color 0.15s;
}
.recover-input:focus { border-color: var(--blue); }
.recover-btn {
  padding: 12px 20px;
  background: var(--slate);
  color: white;
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 500;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s;
}
.recover-btn:hover { background: var(--blue); }
.recover-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.recover-success {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-family: var(--sans);
  font-size: 14px;
  color: var(--sage-dark);
  background: rgba(168,195,160,0.12);
  border: 1px solid rgba(168,195,160,0.35);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  max-width: 400px;
  margin: 0 auto;
  text-align: left;
  line-height: 1.5;
}
.recover-error {
  font-family: var(--sans);
  font-size: 14px;
  color: var(--clay);
  text-align: center;
}
@media (max-width: 480px) {
  .recover-form { flex-direction: column; }
}

</style>

<script>
  // ── Local price detection ──
  (function() {
    const PRICES = {
      AU: { symbol: 'A$', amount: '75',  note: 'AUD' },
      GB: { symbol: '£',  amount: '39',  note: 'GBP' },
      CA: { symbol: 'C$', amount: '67',  note: 'CAD' },
      NZ: { symbol: 'NZ$',amount: '82',  note: 'NZD' },
      DE: { symbol: '€',  amount: '45',  note: 'EUR' },
      FR: { symbol: '€',  amount: '45',  note: 'EUR' },
      IE: { symbol: '€',  amount: '45',  note: 'EUR' },
      NL: { symbol: '€',  amount: '45',  note: 'EUR' },
      ES: { symbol: '€',  amount: '45',  note: 'EUR' },
      IT: { symbol: '€',  amount: '45',  note: 'EUR' },
      PT: { symbol: '€',  amount: '45',  note: 'EUR' },
      BE: { symbol: '€',  amount: '45',  note: 'EUR' },
      AT: { symbol: '€',  amount: '45',  note: 'EUR' },
      SE: { symbol: 'kr', amount: '499', note: 'SEK' },
      NO: { symbol: 'kr', amount: '499', note: 'NOK' },
    };

    // Use Cloudflare's exposed timezone as a proxy for region
    // Then fetch our own geo endpoint to get the country
    fetch('/api/geo').then(r => r.json()).then(data => {
      const country = data.country;
      const price = PRICES[country];
      if (!price) return; // default USD stays

      const priceEl = document.getElementById('buy-price-display');
      const currencyEl = document.getElementById('buy-currency-display');
      const heroBtn = document.getElementById('hero-cta-btn');

      if (priceEl && currencyEl) {
        priceEl.childNodes[0].textContent = price.symbol + price.amount + ' ';
        currencyEl.textContent = price.note;
      }
      if (heroBtn) {
        heroBtn.textContent = 'Start for ' + price.symbol + price.amount;
      }
    }).catch(() => {}); // silent fail — default USD price stays
  })();

  // ── Checkout ──
  const btn = document.getElementById('grow-checkout-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Opening checkout...';
      try {
        const pattern = localStorage.getItem('adhd_pattern') || '';
        const source = document.referrer ? new URL(document.referrer).hostname : 'direct';
        const res = await fetch('/api/grow/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pattern, source }),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          btn.disabled = false;
          btn.textContent = 'Start the program';
          alert('Something went wrong. Please try again.');
        }
      } catch (e) {
        btn.disabled = false;
        btn.textContent = 'Start the program';
        alert('Something went wrong. Please try again.');
      }
    });
  }

  // Access gate form (shown when redirected with ?auth=required or ?auth=invalid)
  const gateBtn = document.getElementById('gate-btn');
  const gateEmail = document.getElementById('gate-email');
  const gateSuccess = document.getElementById('gate-success');
  const gateError = document.getElementById('gate-error');
  const gateForm = document.getElementById('gate-form');

  if (gateBtn && gateEmail) {
    gateEmail.addEventListener('keydown', e => {
      if (e.key === 'Enter') gateBtn.click();
    });
    gateBtn.addEventListener('click', async () => {
      const email = gateEmail.value.trim();
      if (!email) { gateEmail.focus(); return; }
      gateBtn.disabled = true;
      gateBtn.textContent = 'Sending...';
      if (gateError) gateError.style.display = 'none';
      try {
        await fetch('/api/grow/recover', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (gateForm) gateForm.style.display = 'none';
        if (gateSuccess) gateSuccess.style.display = 'flex';
      } catch(e) {
        gateBtn.disabled = false;
        gateBtn.textContent = 'Send my link';
        if (gateError) {
          gateError.textContent = 'Something went wrong. Try again or email hello@adhdreflect.com.';
          gateError.style.display = 'block';
        }
      }
    });
  }


  const recoverBtn = document.getElementById('recover-btn');
  const recoverEmail = document.getElementById('recover-email');
  const recoverSuccess = document.getElementById('recover-success');
  const recoverError = document.getElementById('recover-error');

  if (recoverBtn) {
    recoverEmail.addEventListener('keydown', e => {
      if (e.key === 'Enter') recoverBtn.click();
    });

    recoverBtn.addEventListener('click', async () => {
      const email = recoverEmail.value.trim();
      if (!email) return;
      recoverBtn.disabled = true;
      recoverBtn.textContent = 'Sending...';
      recoverError.style.display = 'none';
      try {
        await fetch('/api/grow/recover', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        // Always show success — don't reveal whether email exists
        document.getElementById('recover-form').style.display = 'none';
        recoverSuccess.style.display = 'flex';
      } catch(e) {
        recoverBtn.disabled = false;
        recoverBtn.textContent = 'Send my link';
        recoverError.textContent = 'Something went wrong. Try again or email hello@adhdreflect.com.';
        recoverError.style.display = 'block';
      }
    });
  }

</script>
