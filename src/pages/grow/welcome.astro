---
import Base from '../../layouts/Base.astro';
const sessionId = Astro.url.searchParams.get('session_id');
---
<Base title="You're in" description="Welcome to Both of You." current="grow">
  <div class="grow-welcome">
    <div class="grow-welcome-inner">
      <div class="grow-welcome-icon">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="23" stroke="#4A6FA5" stroke-width="1.5"/>
          <path d="M14 24l8 8 12-16" stroke="#4A6FA5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h1 class="grow-welcome-title">You're in.</h1>

      <!-- On-screen access link, filled in once the webhook has written it -->
      <div id="access-ready" hidden>
        <p class="grow-welcome-body">Here's your access link.</p>
        <a id="access-link" class="grow-welcome-cta" href="#">Open Both of You</a>
        <p class="grow-welcome-body">Bookmark this. It's how you get back in on any device. No password.</p>
      </div>
      <p id="access-checking" class="grow-welcome-body" hidden>Fetching your access link...</p>

      <!-- Fallback shown from the start, so every path out is visible immediately -->
      <p class="grow-welcome-body">Your access link is also on its way to your email. Bookmark it or save the email.</p>
      <p class="grow-welcome-body">You can get back in any time at <a href="/grow">adhdreflect.com/grow</a> using the email address you paid with.</p>
      <p class="grow-welcome-note">Nothing after a few minutes? Check your spam folder, or email <a href="mailto:hello@adhdreflect.com">hello@adhdreflect.com</a></p>
      <a href="/grow" class="grow-welcome-back">Back to the program page</a>
    </div>
  </div>

  <script>
    // Resolve the access link on screen. The webhook writes it keyed by the
    // Stripe session ID; it may lag the redirect by a few seconds, so poll for
    // about 30 seconds then stop. The emailed link and the /grow recovery path
    // are already shown, so a timeout still leaves two ways in.
    const sid = new URLSearchParams(window.location.search).get('session_id');
    const ready = document.getElementById('access-ready');
    const link = document.getElementById('access-link');
    const checking = document.getElementById('access-checking');
    if (sid) {
      checking.hidden = false;
      let tries = 0;
      const MAX = 15; // ~30s at 2s
      const poll = async () => {
        tries++;
        try {
          const res = await fetch('/api/grow/session-access?session_id=' + encodeURIComponent(sid));
          const data = await res.json();
          if (data && data.accessUrl) {
            link.setAttribute('href', data.accessUrl);
            ready.hidden = false;
            checking.hidden = true;
            return;
          }
        } catch (e) {}
        if (tries >= MAX) { checking.hidden = true; return; }
        setTimeout(poll, 2000);
      };
      poll();
    }
  </script>
</Base>

<style>
.grow-welcome {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: var(--space-3xl) var(--page-pad);
}
.grow-welcome-inner {
  max-width: 480px;
  text-align: center;
}
.grow-welcome-icon { margin-bottom: var(--space-xl); }
.grow-welcome-title {
  font-family: var(--serif);
  font-size: 48px;
  font-weight: 300;
  color: var(--slate);
  font-variation-settings: 'opsz' 48;
  margin-bottom: var(--space-lg);
}
.grow-welcome-body {
  font-family: var(--sans);
  font-size: 17px;
  color: var(--pewter);
  line-height: 1.6;
  margin-bottom: var(--space-sm);
}
.grow-welcome-note {
  font-family: var(--sans);
  font-size: 14px;
  color: var(--pewter);
  margin-top: var(--space-xl);
  margin-bottom: var(--space-xl);
  line-height: 1.6;
}
.grow-welcome-note a { color: var(--blue); }
.grow-welcome-cta {
  display: inline-block;
  margin: var(--space-sm) 0 var(--space-md);
  padding: 16px 40px;
  background: var(--blue);
  color: #fff;
  font-family: var(--sans);
  font-size: 16px;
  font-weight: 500;
  border-radius: var(--radius-pill);
  text-decoration: none;
  transition: background 0.15s;
}
.grow-welcome-cta:hover { background: var(--blue-deep); }
.grow-welcome-back {
  display: inline-block;
  font-family: var(--sans);
  font-size: 14px;
  color: var(--blue);
  text-decoration: none;
}
</style>