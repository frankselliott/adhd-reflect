<script>

const filterBtns = document.querySelectorAll('.filter-btn');
const cards = document.querySelectorAll('.card[data-category]');
const noResults = document.getElementById('no-results');
const countLabel = document.getElementById('count-label');
const countAll = document.getElementById('count-all');

countAll.textContent = cards.length;

const categoryNames = {
  all: 'all resources',
  podcasts: 'podcasts',
  social: 'social &amp; YouTube',
  academic: 'organisations',
  books: 'books',
  community: 'communities'
};

function updateCount(filter, visible) {
  if (filter === 'all') {
    countLabel.textContent = `Showing all ${visible} resources`;
  } else {
    countLabel.innerHTML = `Showing ${visible} ${categoryNames[filter]}`;
  }
}

function filterCards(filter) {
  let visible = 0;
  cards.forEach((card, i) => {
    const show = filter === 'all' || card.dataset.category === filter;
    if (show) {
      card.classList.remove('hidden');
      card.style.animationDelay = `${(visible * 0.04)}s`;
      void card.offsetWidth; // reflow
      card.style.animation = 'none';
      requestAnimationFrame(() => {
        card.style.animation = '';
      });
      visible++;
    } else {
      card.classList.add('hidden');
    }
  });

  noResults.style.display = visible === 0 ? 'block' : 'none';
  updateCount(filter, visible);
}

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterCards(btn.dataset.filter);
  });
});

// Init
updateCount('all', cards.length);



function copyCode() {
  navigator.clipboard.writeText('THERAPY20').then(() => {
    const btn = document.querySelector('.therapy-copy-btn');
    if (btn) {
      btn.textContent = '✓ Copied';
      setTimeout(() => btn.textContent = 'Copy code', 2000);
    }
  }).catch(() => {
    const code = document.getElementById('therapy-code');
    if (code) {
      const range = document.createRange();
      range.selectNode(code);
      window.getSelection().removeAllRanges();
      window.getSelection().addRange(range);
    }
  });
}

</script>

