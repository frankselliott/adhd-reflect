---
import Base from '../layouts/Base.astro';
---
<Base title="Admin" description="ADHD Reflect admin dashboard" noindex={true}>
  <meta name="robots" content="noindex, nofollow" />

  <div id="admin-root" style="max-width:960px;margin:0 auto;padding:40px 24px 120px">

    <!-- Auth -->
    <div id="auth-form">
      <div style="font-family:var(--serif);font-size:28px;font-weight:300;color:var(--slate);margin-bottom:24px">Admin</div>
      <div style="display:flex;gap:8px;align-items:center">
        <input type="password" id="admin-key" placeholder="Password" style="
          font-family:var(--sans);font-size:15px;padding:12px 16px;
          border:1.5px solid rgba(31,42,55,0.1);border-radius:10px;
          background:white;width:280px;outline:none;
        "/>
        <button onclick="loadAll()" style="
          font-family:var(--sans);font-size:15px;font-weight:500;
          padding:12px 24px;border-radius:10px;border:none;
          background:var(--blue);color:white;cursor:pointer;
        ">Sign in</button>
      </div>
    </div>

    <!-- Dashboard -->
    <div id="dashboard" style="display:none">

      <!-- Tab nav -->
      <div style="display:flex;gap:4px;margin-bottom:32px;border-bottom:1px solid rgba(31,42,55,0.08);padding-bottom:0;align-items:center;flex-wrap:wrap">
        <button class="tab-btn active" onclick="showTab('site')" id="tab-site">Site</button>
        <button class="tab-btn" onclick="showTab('course')" id="tab-course">Course</button>
        <button class="tab-btn" onclick="showTab('email')" id="tab-email">Email</button>
        <button class="tab-btn" onclick="showTab('revenue')" id="tab-revenue">Revenue</button>
        <button class="tab-btn" onclick="showTab('stats')" id="tab-stats">Stats</button>
        <button class="tab-btn" onclick="showTab('codes')" id="tab-codes">Codes</button>
        <button class="tab-btn" onclick="showTab('cards')" id="tab-cards">Missing cards</button>
        <button onclick="logout()" id="logout-btn" style="margin-left:auto;font-family:var(--mono);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;padding:6px 12px;border-radius:6px;border:1px solid rgba(31,42,55,0.12);background:white;cursor:pointer;color:var(--pewter)">Log out</button>
      </div>

      <!-- ── SITE TAB ── -->
      <div id="pane-site" class="tab-pane">
        <div id="search-summary" class="stat-grid"></div>
        <div id="site-loading" class="tab-loading">Loading...</div>

        <div class="section-head">
          <h2>Search trend — daily</h2>
        </div>
        <div id="search-chart" style="margin-bottom:40px"></div>

        <div class="section-head">
          <h2>Unmatched queries</h2>
          <p>What people searched for and didn't find. These are your content gaps.</p>
        </div>
        <div id="unmatched-list"></div>

        <div class="section-head" style="margin-top:40px">
          <h2>Top matched cards</h2>
        </div>
        <div id="top-cards"></div>

        <div class="section-head" style="margin-top:40px">
          <h2>Recent searches</h2>
        </div>
        <div id="recent-list"></div>
      </div>

      <!-- ── COURSE TAB ── -->
      <div id="pane-course" class="tab-pane" style="display:none">
        <div id="course-summary" class="stat-grid"></div>
        <div id="course-loading" class="tab-loading">Loading...</div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:32px 0">
          <div class="card-panel">
            <div class="panel-label">Pattern distribution</div>
            <div id="pattern-dist"></div>
          </div>
          <div class="card-panel">
            <div class="panel-label">Purchase source</div>
            <div id="source-dist"></div>
          </div>
        </div>

        <div class="section-head">
          <h2>Module completion rates</h2>
          <p>How many buyers have completed each module.</p>
        </div>
        <div id="module-rates"></div>

        <div class="section-head" style="margin-top:40px">
          <h2>Recent purchasers</h2>
          <p>Anonymised. No emails, no identifying information.</p>
        </div>
        <div id="purchaser-list"></div>
      </div>

      <!-- ── EMAIL TAB ── -->
      <div id="pane-email" class="tab-pane" style="display:none">
        <div id="email-loading" style="font-family:var(--sans);font-size:14px;color:var(--pewter);padding:8px 0">Loading...</div>
        <div id="email-body" style="display:none">
          <div id="email-summary" class="stat-grid"></div>

          <div id="email-sync-flag" style="display:none;margin-bottom:24px"></div>

          <div class="section-head">
            <h2>Drip progress</h2>
            <p>Where active subscribers sit in the welcome sequence. Step 0 have not had the first email yet.</p>
          </div>
          <div id="drip-funnel" style="margin-bottom:40px"></div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:40px">
            <div class="card-panel">
              <div class="panel-label">Subscribers by quiz pattern</div>
              <div id="email-patterns"></div>
            </div>
            <div class="card-panel">
              <div class="panel-label">Last drip run</div>
              <div id="email-last-run"></div>
            </div>
          </div>

          <div class="section-head">
            <h2>Recent sends</h2>
            <p>Last 20 of our own sends, filtered to adhdreflect.com so the shared Resend account's other businesses never show here. Bounced and complained are highlighted.</p>
          </div>
          <div id="email-recent"></div>
        </div>
      </div>

      <!-- ── REVENUE TAB ── -->
      <div id="pane-revenue" class="tab-pane" style="display:none">
        <div id="revenue-loading" style="font-family:var(--sans);font-size:14px;color:var(--pewter);padding:8px 0">Loading...</div>
        <div id="revenue-body" style="display:none">
          <div id="revenue-summary" class="stat-grid"></div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:32px 0">
            <div class="card-panel">
              <div class="panel-label">Purchases by country</div>
              <div id="revenue-country"></div>
            </div>
            <div class="card-panel">
              <div class="panel-label">Refunds and discounts</div>
              <div id="revenue-refunds"></div>
            </div>
          </div>

          <div class="section-head">
            <h2>Recent purchases</h2>
            <p>Adaptive Pricing is on, so both the amount charged and the settlement amount are shown.</p>
          </div>
          <div id="revenue-recent"></div>
        </div>
        <div id="revenue-unconfigured" style="display:none;font-family:var(--sans);font-size:14px;color:var(--pewter);padding:8px 0">Stripe is not configured.</div>
      </div>

      <!-- ── CODES TAB ── -->
      <div id="pane-codes" class="tab-pane" style="display:none">
        <div class="card-panel" style="margin-bottom:32px">
          <div class="panel-label">Create a code</div>
          <div style="display:flex;flex-direction:column;gap:12px;max-width:480px">
            <input id="code-input" placeholder="Code (e.g. FRIEND2024)" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none"/>
            <select id="code-type" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none">
              <option value="free">Free (100% off)</option>
              <option value="percent">Percentage off</option>
            </select>
            <div id="code-value-wrap">
              <input id="code-value" type="number" placeholder="Discount %" min="1" max="99" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none;width:100%"/>
            </div>
            <div id="code-access-days-wrap">
              <select id="code-access-days" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none;width:100%">
                <option value="">Lifetime access (no expiry)</option>
                <option value="7">7 days access</option>
                <option value="14">14 days access</option>
                <option value="30">30 days access</option>
                <option value="60">60 days access</option>
                <option value="90">90 days access</option>
              </select>
              <div style="font-family:var(--sans);font-size:12px;color:var(--pewter);margin-top:6px;padding-left:2px">Time limit on the access itself — not the code expiry date below.</div>
            </div>
            <input id="code-max-uses" type="number" placeholder="Max uses (leave blank = unlimited)" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none"/>
            <input id="code-expires" type="date" placeholder="Code expires (optional)" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none"/>
            <input id="code-notes" placeholder="Notes (internal only)" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none"/>
            <button onclick="createCode()" style="font-family:var(--sans);font-size:14px;font-weight:500;padding:12px 20px;border-radius:8px;border:none;background:var(--blue);color:white;cursor:pointer;align-self:flex-start">Create code</button>
            <div id="code-feedback" style="font-family:var(--mono);font-size:11px;color:var(--sage-dark)"></div>
          </div>
        </div>

        <div class="section-head">
          <h2>Active codes</h2>
        </div>
        <div id="codes-loading" class="tab-loading">Loading...</div>
        <div id="codes-list"></div>
      </div>

      <!-- ── MISSING CARDS TAB ── -->
      <div id="pane-cards" class="tab-pane" style="display:none">
        <div class="section-head">
          <h2>Unmatched queries — anonymised</h2>
          <p>Things people searched for and couldn't find. Each one is a potential card gap. No user data attached.</p>
        </div>
        <div style="margin-bottom:16px;display:flex;gap:8px">
          <input id="card-filter" placeholder="Filter..." oninput="filterCards()" style="font-family:var(--sans);font-size:14px;padding:10px 14px;border:1.5px solid rgba(31,42,55,0.1);border-radius:8px;background:white;outline:none;flex:1"/>
          <button onclick="exportCards()" style="font-family:var(--mono);font-size:11px;letter-spacing:0.08em;padding:10px 16px;border-radius:8px;border:1px solid rgba(31,42,55,0.1);background:white;cursor:pointer;color:var(--pewter)">Export CSV</button>
        </div>
        <div id="cards-loading" class="tab-loading">Loading...</div>
        <div id="cards-gap-list"></div>
      </div>

      <!-- ── STATS TAB ── -->
      <div id="pane-stats" class="tab-pane" style="display:none">
        <div id="stats-loading" class="tab-loading">Loading...</div>
        <div id="stats-body" style="display:none">
          <div id="stats-summary" class="stat-grid"></div>

          <div class="section-head">
            <h2>Visits, last 30 days</h2>
            <p>First-party page counts. These are page views, not unique visitors, since we store no identifiers.</p>
          </div>
          <div id="stats-daily" style="margin-bottom:40px"></div>

          <div class="section-head">
            <h2>Top 20 pages</h2>
          </div>
          <div id="stats-top"></div>
        </div>
      </div>

    </div>
  </div>
</Base>

<style>
  .tab-btn {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 18px 12px;
    border: none;
    background: none;
    color: var(--pewter);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.15s;
  }
  .tab-btn.active {
    color: var(--blue);
    border-bottom-color: var(--blue);
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
    margin-bottom: 32px;
  }
  .card-panel {
    background: white;
    border-radius: 12px;
    border: 1px solid rgba(31,42,55,0.06);
    padding: 20px 24px;
  }
  .panel-label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pewter);
    margin-bottom: 16px;
  }
  .section-head { margin-bottom: 16px; }
  .section-head h2 {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--slate);
    margin-bottom: 4px;
  }
  .section-head p {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--pewter);
  }
  .stat-card {
    background: white;
    border-radius: 12px;
    border: 1px solid rgba(31,42,55,0.06);
    padding: 16px 18px;
  }
  .stat-label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .stat-value {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 300;
    color: var(--slate);
  }
  .row-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(31,42,55,0.04);
    font-family: var(--sans);
    font-size: 14px;
    color: var(--slate);
  }
  .badge {
    font-family: var(--mono);
    font-size: 9px;
    padding: 3px 7px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .badge-match { background: rgba(75,107,78,0.1); color: #4B6B4E; }
  .badge-miss { background: rgba(184,80,56,0.1); color: #B85038; }
  .badge-crisis { background: rgba(201,123,106,0.1); color: #C97B6A; }
  .badge-free { background: rgba(168,195,160,0.2); color: #4B6B4E; }
  .badge-pct { background: rgba(74,111,165,0.1); color: #4A6FA5; }
  .badge-off { background: rgba(31,42,55,0.06); color: var(--pewter); }
  .module-bar-wrap { display: flex; align-items: center; gap: 12px; padding: 7px 0; border-bottom: 1px solid rgba(31,42,55,0.04); }
  .module-bar-label { font-family: var(--mono); font-size: 10px; color: var(--pewter); width: 28px; flex-shrink: 0; }
  .module-bar-track { flex: 1; height: 6px; background: var(--mist); border-radius: 3px; overflow: hidden; }
  .module-bar-fill { height: 100%; background: var(--blue); border-radius: 3px; }
  .module-bar-count { font-family: var(--mono); font-size: 10px; color: var(--pewter); width: 28px; text-align: right; flex-shrink: 0; }
  .tab-loading { font-family: var(--sans); font-size: 14px; color: var(--pewter); padding: 8px 0; }
</style>

<script is:inline>
  const SS_KEY = 'adhd-admin-key';
  let adminKey = '';
  let unmatchedRaw = [];
  let searchDetailData = null; // shared by the Site and Missing cards tabs
  // Each tab loads its own detail on first view. Login (section=all) only
  // brings back the summary counts, so it never waits on the full data set,
  // Resend or Stripe.
  const loaded = { site:false, course:false, codes:false, cards:false, email:false, revenue:false, stats:false };

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // Fetch a section with the admin key. A 401 means the stored key is stale:
  // clear it and drop back to the login form.
  async function adminFetch(section) {
    const res = await fetch('/api/admin?key=' + encodeURIComponent(adminKey) + '&section=' + section);
    if (res.status === 401) { logout(); throw new Error('unauthorized'); }
    return res.json();
  }

  function logout() {
    try { sessionStorage.removeItem(SS_KEY); } catch (e) {}
    adminKey = '';
    document.getElementById('dashboard').style.display = 'none';
    document.getElementById('auth-form').style.display = 'block';
    const input = document.getElementById('admin-key');
    if (input) input.value = '';
  }

  function hideLoading(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

  async function showTab(name) {
    document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none');
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('pane-' + name).style.display = 'block';
    document.getElementById('tab-' + name).classList.add('active');
    if (!loaded[name]) { loaded[name] = true; await loadSection(name); }
  }

  // Load one tab's detail. Loading states live in each pane and are hidden as
  // the detail arrives.
  async function loadSection(name) {
    try {
      if (name === 'site') {
        const d = await adminFetch('search');
        searchDetailData = d.search || null;
        hideLoading('site-loading');
        renderSiteDetail(searchDetailData);
      } else if (name === 'course') {
        const d = await adminFetch('course');
        hideLoading('course-loading');
        renderCourseDetail(d.course);
      } else if (name === 'codes') {
        const d = await adminFetch('discounts');
        hideLoading('codes-loading');
        renderCodes(d.discounts);
      } else if (name === 'cards') {
        // Reuse the Site tab's search detail if it is already loaded.
        const search = searchDetailData || ((await adminFetch('search')).search || null);
        searchDetailData = search;
        hideLoading('cards-loading');
        renderCardGaps(search);
      } else if (name === 'stats') {
        const d = await adminFetch('stats');
        renderStats(d.stats);
      } else if (name === 'email') {
        await loadEmail();
      } else if (name === 'revenue') {
        await loadRevenue();
      }
    } catch (e) {
      if (e.message === 'unauthorized') return; // already dropped to login
      const el = document.getElementById(name + '-loading');
      if (el) { el.style.display = 'block'; el.textContent = 'Error: ' + e.message; }
    }
  }

  // Sign in (or restore a stored key). section=all returns only summary counts.
  async function loadAll(existingKey) {
    adminKey = existingKey || document.getElementById('admin-key').value;
    if (!adminKey) return;
    let data;
    try {
      data = await adminFetch('all');
    } catch (e) {
      if (e.message !== 'unauthorized') alert('Error: ' + e.message);
      return;
    }
    if (data.error) { alert(data.error); return; }
    try { sessionStorage.setItem(SS_KEY, adminKey); } catch (e) {}
    document.getElementById('auth-form').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
    Object.keys(loaded).forEach(k => loaded[k] = false);
    searchDetailData = null;
    renderSiteSummary(data.search && data.search.summary);
    renderCourseSummary(data.course && data.course.summary);
    showTab('site');
  }

  document.getElementById('admin-key')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') loadAll();
  });

  // Restore a stored key (sessionStorage, so it clears when the browser closes)
  // and skip straight to the dashboard.
  (function () {
    let stored = '';
    try { stored = sessionStorage.getItem(SS_KEY) || ''; } catch (e) {}
    if (stored) loadAll(stored);
  })();

  // ── Toggle value field for percent codes ──
  document.getElementById('code-type')?.addEventListener('change', function() {
    const isFree = this.value === 'free';
    document.getElementById('code-value-wrap').style.display = isFree ? 'none' : 'block';
    document.getElementById('code-access-days-wrap').style.display = isFree ? 'block' : 'none';
  });
  document.getElementById('code-type')?.dispatchEvent(new Event('change'));

  // ── SITE ──
  // Summary strip renders instantly from the section=all login payload.
  function renderSiteSummary(s) {
    if (!s) return;
    document.getElementById('search-summary').innerHTML = [
      { label: 'Total searches', value: s.total, color: '#4A6FA5' },
      { label: 'Matched', value: s.matched, color: '#4B6B4E' },
      { label: 'Unmatched', value: s.unmatched, color: '#B85038' },
      { label: 'Crisis', value: s.crisis, color: '#C97B6A' },
      { label: 'Unique queries', value: s.uniqueQueries, color: '#9B8BB4' },
      { label: 'Match rate', value: s.total > 0 ? Math.round(s.matched / s.total * 100) + '%' : '—', color: '#4B6B4E' },
    ].map(c => `<div class="stat-card"><div class="stat-label" style="color:${c.color}">${c.label}</div><div class="stat-value">${c.value}</div></div>`).join('');
  }

  // Detail (chart, lists) loads on first view of the Site tab.
  function renderSiteDetail(search) {
    if (!search) return;

    // Mini chart
    const days = Object.entries(search.dailyCounts || {}).sort((a, b) => a[0].localeCompare(b[0])).slice(-30);
    const max = Math.max(...days.map(d => d[1]), 1);
    document.getElementById('search-chart').innerHTML = `
      <div style="display:flex;align-items:flex-end;gap:3px;height:60px;background:white;border-radius:10px;padding:12px 16px;border:1px solid rgba(31,42,55,0.06)">
        ${days.map(([day, count]) => `<div title="${day}: ${count}" style="flex:1;height:${Math.max(4, count/max*100)}%;background:rgba(74,111,165,0.4);border-radius:2px 2px 0 0;min-width:4px"></div>`).join('')}
      </div>
      <div style="font-family:var(--mono);font-size:10px;color:var(--pewter);margin-top:6px">Last 30 days · ${days.length} days with searches</div>
    `;

    unmatchedRaw = search.unmatchedQueries || [];
    renderUnmatched(unmatchedRaw);

    document.getElementById('top-cards').innerHTML = (search.topCards || []).map((c, i) => `
      <div class="row-item">
        <span style="font-family:var(--mono);font-size:12px;color:var(--pewter);width:32px">${c.count}×</span>
        <span style="font-family:var(--mono);font-size:10px;color:var(--blue);width:36px">${c.id}</span>
        <span>${c.title || ''}</span>
      </div>
    `).join('');

    document.getElementById('recent-list').innerHTML = (search.recentSearches || []).map(s => `
      <div class="row-item">
        <span class="badge ${s.matched ? 'badge-match' : s.crisis ? 'badge-crisis' : 'badge-miss'}">${s.matched ? 'MATCH' : s.crisis ? 'CRISIS' : 'MISS'}</span>
        <div style="flex:1;min-width:0">
          <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">"${s.query}"</div>
          <div style="font-family:var(--mono);font-size:10px;color:var(--pewter);margin-top:2px">${s.topMatch ? s.topMatch + ' · ' + (s.topMatchTitle || '') + ' · ' : ''}${new Date(s.timestamp).toLocaleString()}</div>
        </div>
      </div>
    `).join('');
  }

  function renderUnmatched(list) {
    document.getElementById('unmatched-list').innerHTML = list.length === 0
      ? '<p style="color:var(--pewter);font-size:14px;font-family:var(--sans)">No unmatched queries yet.</p>'
      : list.map(q => `
        <div style="background:rgba(184,80,56,0.04);border:1px solid rgba(184,80,56,0.1);border-radius:10px;padding:12px 16px;margin-bottom:8px">
          <div style="font-family:var(--serif);font-size:15px;color:var(--slate)">"${q.query}"</div>
          <div style="font-family:var(--mono);font-size:10px;color:var(--pewter);margin-top:4px">${new Date(q.timestamp).toLocaleDateString()}</div>
        </div>
      `).join('');
  }

  // ── COURSE ──
  function renderCourseSummary(s) {
    if (!s) return;
    document.getElementById('course-summary').innerHTML = [
      { label: 'Total buyers', value: s.totalPurchasers, color: '#4A6FA5' },
      { label: 'Completed all 20', value: s.completedCourse, color: '#4B6B4E' },
      { label: 'Reached halfway', value: s.reachedHalfway, color: '#9B8BB4' },
      { label: 'Started only', value: s.startedOnly, color: '#C97B6A' },
      { label: 'Avg modules done', value: s.avgCompletion, color: '#56606E' },
    ].map(c => `<div class="stat-card"><div class="stat-label" style="color:${c.color}">${c.label}</div><div class="stat-value">${c.value}</div></div>`).join('');
  }

  function renderCourseDetail(course) {
    if (!course) return;

    // Pattern distribution
    document.getElementById('pattern-dist').innerHTML = Object.entries(course.patternDistribution || {})
      .sort((a, b) => b[1] - a[1])
      .map(([p, count]) => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(31,42,55,0.04)">
          <span style="font-family:var(--sans);font-size:13px;color:var(--slate);text-transform:capitalize">${p}</span>
          <span style="font-family:var(--mono);font-size:11px;color:var(--blue)">${count}</span>
        </div>
      `).join('') || '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No data yet.</p>';

    // Source distribution
    document.getElementById('source-dist').innerHTML = Object.entries(course.sourceDistribution || {})
      .sort((a, b) => b[1] - a[1])
      .map(([s, count]) => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(31,42,55,0.04)">
          <span style="font-family:var(--sans);font-size:13px;color:var(--slate)">${s}</span>
          <span style="font-family:var(--mono);font-size:11px;color:var(--blue)">${count}</span>
        </div>
      `).join('') || '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No data yet.</p>';

    // Module completion rates
    const maxModCount = Math.max(...Object.values(course.moduleCompletionCounts || {}), 1);
    const modules = ['m1','m2','m3','m4','m5','m6','m7','m8','m9','m10','m11','m12','m13','m14','m15','m16','m17','m18','m19','m20'];
    document.getElementById('module-rates').innerHTML = modules.map(mid => {
      const count = (course.moduleCompletionCounts || {})[mid] || 0;
      const pct = Math.round(count / maxModCount * 100);
      return `
        <div class="module-bar-wrap">
          <span class="module-bar-label">${mid}</span>
          <div class="module-bar-track"><div class="module-bar-fill" style="width:${pct}%"></div></div>
          <span class="module-bar-count">${count}</span>
        </div>
      `;
    }).join('');

    // Recent purchasers (anonymised)
    document.getElementById('purchaser-list').innerHTML = (course.recentPurchasers || []).map(u => `
      <div class="row-item">
        <span style="font-family:var(--mono);font-size:10px;color:var(--pewter);width:80px;flex-shrink:0">${u.purchasedAt ? new Date(u.purchasedAt).toLocaleDateString() : '—'}</span>
        <span style="font-family:var(--sans);font-size:13px;color:var(--slate);text-transform:capitalize;width:100px;flex-shrink:0">${u.pattern || '—'}</span>
        <span style="font-family:var(--mono);font-size:11px;color:var(--blue);width:60px;flex-shrink:0">${u.completedCount}/20</span>
        <span style="font-family:var(--sans);font-size:12px;color:var(--pewter)">${u.source || 'direct'}</span>
      </div>
    `).join('') || '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No purchases yet.</p>';
  }

  // ── CODES ──
  function renderCodes(discounts) {
    const codes = (discounts?.codes || []).sort((a, b) => (b.createdAt || '').localeCompare(a.createdAt || ''));
    document.getElementById('codes-list').innerHTML = codes.length === 0
      ? '<p style="font-family:var(--sans);font-size:14px;color:var(--pewter)">No codes created yet.</p>'
      : `
        <table style="width:100%;border-collapse:collapse">
          <thead>
            <tr style="font-family:var(--mono);font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:var(--pewter)">
              <th style="text-align:left;padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)">Code</th>
              <th style="text-align:left;padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)">Type</th>
              <th style="text-align:left;padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)">Uses</th>
              <th style="text-align:left;padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)">Expires</th>
              <th style="text-align:left;padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)">Status</th>
              <th style="text-align:left;padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)">Notes</th>
              <th style="padding:8px 0;border-bottom:1px solid rgba(31,42,55,0.08)"></th>
            </tr>
          </thead>
          <tbody>
            ${codes.map(c => `
              <tr style="border-bottom:1px solid rgba(31,42,55,0.04)">
                <td style="padding:10px 0;font-family:var(--mono);font-size:12px;color:var(--slate);font-weight:500">${c.code}</td>
                <td style="padding:10px 0">
                  <span class="badge ${c.type === 'free' ? 'badge-free' : 'badge-pct'}">${c.type === 'free' ? 'FREE' : c.value + '%'}</span>
                </td>
                <td style="padding:10px 0;font-family:var(--mono);font-size:11px;color:var(--pewter)">${c.usedCount}${c.maxUses ? '/' + c.maxUses : ''}</td>
                <td style="padding:10px 0;font-family:var(--mono);font-size:11px;color:var(--pewter)">${c.expiresAt ? new Date(c.expiresAt).toLocaleDateString() : '—'}</td>
                <td style="padding:10px 0"><span class="badge ${c.active ? 'badge-match' : 'badge-off'}">${c.active ? 'ACTIVE' : 'OFF'}</span></td>
                <td style="padding:10px 0;font-family:var(--sans);font-size:12px;color:var(--pewter)">${c.notes || ''}</td>
                <td style="padding:10px 0;text-align:right;display:flex;gap:8px;justify-content:flex-end">
                  <button onclick="toggleCode('${c.code}')" style="font-family:var(--mono);font-size:9px;letter-spacing:0.08em;padding:5px 10px;border-radius:6px;border:1px solid rgba(31,42,55,0.1);background:white;cursor:pointer;color:var(--pewter)">${c.active ? 'Pause' : 'Resume'}</button>
                  <button onclick="deleteCode('${c.code}')" style="font-family:var(--mono);font-size:9px;letter-spacing:0.08em;padding:5px 10px;border-radius:6px;border:1px solid rgba(184,80,56,0.2);background:white;cursor:pointer;color:#B85038">Delete</button>
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
  }

  // POST an action with the admin key. A 401 drops back to login, like adminFetch.
  async function adminPost(body) {
    const res = await fetch('/api/admin?key=' + encodeURIComponent(adminKey), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (res.status === 401) { logout(); throw new Error('unauthorized'); }
    return res.json();
  }

  async function createCode() {
    const code = document.getElementById('code-input').value.trim();
    const type = document.getElementById('code-type').value;
    const value = type === 'free' ? 100 : Number(document.getElementById('code-value').value);
    const maxUses = document.getElementById('code-max-uses').value ? Number(document.getElementById('code-max-uses').value) : null;
    const expiresAt = document.getElementById('code-expires').value || null;
    const notes = document.getElementById('code-notes').value.trim();
    const accessDaysRaw = document.getElementById('code-access-days').value;
    const accessDays = accessDaysRaw ? Number(accessDaysRaw) : null;
    const fb = document.getElementById('code-feedback');
    if (!code) { fb.textContent = 'Code required.'; return; }
    fb.textContent = 'Creating...';
    try {
      const data = await adminPost({ action: 'create_discount', code, type, value, maxUses, expiresAt, notes, accessDays });
      if (data.success) {
        fb.textContent = 'Created: ' + data.code.code;
        document.getElementById('code-input').value = '';
        document.getElementById('code-notes').value = '';
        renderCodes((await adminFetch('discounts')).discounts);
      } else {
        fb.textContent = data.error || 'Error';
      }
    } catch(e) { if (e.message !== 'unauthorized') fb.textContent = e.message; }
  }

  async function toggleCode(code) {
    try {
      await adminPost({ action: 'toggle_discount', code });
      renderCodes((await adminFetch('discounts')).discounts);
    } catch(e) { if (e.message !== 'unauthorized') alert('Error: ' + e.message); }
  }

  async function deleteCode(code) {
    if (!confirm('Delete code ' + code + '?')) return;
    try {
      await adminPost({ action: 'delete_discount', code });
      renderCodes((await adminFetch('discounts')).discounts);
    } catch(e) { if (e.message !== 'unauthorized') alert('Error: ' + e.message); }
  }

  // ── EMAIL (lazy) ──
  async function loadEmail() {
    try {
      const data = await adminFetch('email');
      if (data.error) { document.getElementById('email-loading').textContent = data.error; return; }
      renderEmail(data.email);
    } catch (e) {
      if (e.message !== 'unauthorized') document.getElementById('email-loading').textContent = 'Error: ' + e.message;
    }
  }

  function renderEmail(email) {
    if (!email) return;
    document.getElementById('email-loading').style.display = 'none';
    document.getElementById('email-body').style.display = 'block';

    document.getElementById('email-summary').innerHTML = [
      { label: 'Subscribers', value: email.subscriberCount, color: '#4A6FA5' },
      { label: 'Unsubscribes', value: email.unsubCount, color: '#B85038' },
      { label: 'Unsub rate', value: email.unsubRate + '%', color: '#C97B6A' },
      { label: 'Resend contacts', value: email.resendContactCount == null ? '—' : email.resendContactCount, color: '#9B8BB4' },
      { label: 'Bounced', value: email.bouncedCount || 0, color: '#B85038' },
      { label: 'Complained', value: email.complainedCount || 0, color: '#C97B6A' },
    ].map(c => `<div class="stat-card"><div class="stat-label" style="color:${c.color}">${c.label}</div><div class="stat-value">${c.value}</div></div>`).join('');

    // Sync divergence flag
    const flag = document.getElementById('email-sync-flag');
    if (email.syncDiverges) {
      flag.style.display = 'block';
      flag.innerHTML = `<div style="background:rgba(184,80,56,0.06);border:1px solid rgba(184,80,56,0.2);border-radius:10px;padding:14px 18px;font-family:var(--sans);font-size:14px;color:#B85038">
        Resend holds ${email.resendContactCount} contacts but KV has ${email.subscriberCount} active subscribers. The KV to Resend mirror looks behind.</div>`;
    } else {
      flag.style.display = 'none';
    }

    // Drip funnel as a bar list
    const funnel = email.dripFunnel || {};
    const labels = { 0: 'Step 0', 1: 'Step 1', 2: 'Step 2', 3: 'Step 3', 4: 'Step 4+' };
    const maxF = Math.max(...[0,1,2,3,4].map(i => funnel[i] || 0), 1);
    document.getElementById('drip-funnel').innerHTML = [0,1,2,3,4].map(i => {
      const count = funnel[i] || 0;
      const pct = Math.round(count / maxF * 100);
      return `<div class="module-bar-wrap">
        <span class="module-bar-label" style="width:52px">${labels[i]}</span>
        <div class="module-bar-track"><div class="module-bar-fill" style="width:${pct}%"></div></div>
        <span class="module-bar-count">${count}</span>
      </div>`;
    }).join('');

    // Patterns
    document.getElementById('email-patterns').innerHTML = Object.entries(email.patternBreakdown || {})
      .sort((a, b) => b[1] - a[1])
      .map(([p, count]) => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(31,42,55,0.04)">
          <span style="font-family:var(--sans);font-size:13px;color:var(--slate);text-transform:capitalize">${p}</span>
          <span style="font-family:var(--mono);font-size:11px;color:var(--blue)">${count}</span>
        </div>
      `).join('') || '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No subscribers yet.</p>';

    // Last drip run
    const run = email.lastDripRun;
    document.getElementById('email-last-run').innerHTML = run
      ? `<div style="font-family:var(--sans);font-size:14px;color:var(--slate);line-height:1.9">
          <div>Sent <strong>${run.sent}</strong>, skipped ${run.skipped}, errors ${run.errors}${run.capped ? ' (capped)' : ''}</div>
          <div style="font-family:var(--mono);font-size:11px;color:var(--pewter);margin-top:6px">${run.timestamp ? new Date(run.timestamp).toLocaleString() : ''}</div>
        </div>`
      : '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No drip run recorded yet.</p>';

    // Recent sends
    const bad = s => s === 'bounced' || s === 'complained';
    document.getElementById('email-recent').innerHTML = (email.recentSends || []).length === 0
      ? '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No sends recorded yet.</p>'
      : email.recentSends.map(s => `
        <div class="row-item">
          <span class="badge ${bad(s.status) ? 'badge-miss' : 'badge-off'}">${(s.status || 'sent').toUpperCase()}</span>
          <div style="flex:1;min-width:0">
            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${s.subject || '(no subject)'}</div>
            <div style="font-family:var(--mono);font-size:10px;color:var(--pewter);margin-top:2px">${s.to || ''}${s.created_at ? ' · ' + new Date(s.created_at).toLocaleString() : ''}</div>
          </div>
        </div>
      `).join('');
  }

  // ── REVENUE (lazy) ──
  async function loadRevenue() {
    try {
      const data = await adminFetch('revenue');
      if (data.error) { document.getElementById('revenue-loading').textContent = data.error; return; }
      renderRevenue(data.revenue);
    } catch (e) {
      if (e.message !== 'unauthorized') document.getElementById('revenue-loading').textContent = 'Error: ' + e.message;
    }
  }

  function money(cents, currency) {
    if (cents == null) return '—';
    const amount = (cents / 100).toFixed(2);
    return (currency ? currency.toUpperCase() + ' ' : '') + amount;
  }

  function renderRevenue(rev) {
    document.getElementById('revenue-loading').style.display = 'none';
    if (!rev || !rev.configured) {
      document.getElementById('revenue-unconfigured').style.display = 'block';
      return;
    }
    document.getElementById('revenue-body').style.display = 'block';
    const cur = rev.settlementCurrency;

    document.getElementById('revenue-summary').innerHTML = [
      { label: 'Revenue all time', value: money(rev.allTime.revenue, cur), color: '#4B6B4E' },
      { label: 'Purchases all time', value: rev.allTime.count, color: '#4A6FA5' },
      { label: 'Revenue 30 days', value: money(rev.last30.revenue, cur), color: '#4B6B4E' },
      { label: 'Purchases 30 days', value: rev.last30.count, color: '#4A6FA5' },
    ].map(c => `<div class="stat-card"><div class="stat-label" style="color:${c.color}">${c.label}</div><div class="stat-value" style="font-size:22px">${c.value}</div></div>`).join('');

    // By country
    document.getElementById('revenue-country').innerHTML = Object.entries(rev.byCountry || {})
      .sort((a, b) => b[1] - a[1])
      .map(([c, count]) => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(31,42,55,0.04)">
          <span style="font-family:var(--sans);font-size:13px;color:var(--slate)">${c}</span>
          <span style="font-family:var(--mono);font-size:11px;color:var(--blue)">${count}</span>
        </div>
      `).join('') || '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No data yet.</p>';

    // Refunds and discounts
    document.getElementById('revenue-refunds').innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(31,42,55,0.04)">
        <span style="font-family:var(--sans);font-size:13px;color:var(--slate)">Refunds</span>
        <span style="font-family:var(--mono);font-size:11px;color:var(--blue)">${rev.refunds.count} · ${money(rev.refunds.amount, cur)}</span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0">
        <span style="font-family:var(--sans);font-size:13px;color:var(--slate)">Discount impact</span>
        <span style="font-family:var(--mono);font-size:11px;color:var(--blue)">${money(rev.discountImpact, cur)}</span>
      </div>`;

    // Recent purchases — local charged and settlement side by side
    document.getElementById('revenue-recent').innerHTML = (rev.recent || []).length === 0
      ? '<p style="font-family:var(--sans);font-size:13px;color:var(--pewter)">No purchases yet.</p>'
      : rev.recent.map(p => {
        const settle = p.settleAmount != null ? money(p.settleAmount, p.settleCurrency) : null;
        const local = money(p.localAmount, p.localCurrency);
        const showSettle = settle && settle !== local;
        return `
        <div class="row-item">
          <span style="font-family:var(--mono);font-size:10px;color:var(--pewter);width:80px;flex-shrink:0">${p.date ? new Date(p.date * 1000).toLocaleDateString() : '—'}</span>
          <span style="font-family:var(--mono);font-size:12px;color:var(--slate);width:130px;flex-shrink:0">${local}${showSettle ? '<span style="color:var(--pewter)"> → ' + settle + '</span>' : ''}</span>
          <span style="font-family:var(--sans);font-size:12px;color:var(--pewter);width:40px;flex-shrink:0">${p.country || ''}</span>
          <span style="font-family:var(--sans);font-size:12px;color:var(--slate);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${p.email || ''}</span>
        </div>`;
      }).join('');
  }

  // ── STATS (lazy) ──
  function renderStats(stats) {
    hideLoading('stats-loading');
    document.getElementById('stats-body').style.display = 'block';
    if (!stats) return;
    const daily = stats.daily || {};
    const days = Object.keys(daily).sort().slice(-30);
    const totalRecent = days.reduce((sum, d) => sum + daily[d], 0);

    document.getElementById('stats-summary').innerHTML = [
      { label: 'Views, last 30 days', value: totalRecent, color: '#4A6FA5' },
      { label: 'Views counted (90d)', value: stats.totalCounted || 0, color: '#4B6B4E' },
      { label: 'Days with visits', value: Object.keys(daily).length, color: '#9B8BB4' },
    ].map(c => `<div class="stat-card"><div class="stat-label" style="color:${c.color}">${c.label}</div><div class="stat-value">${c.value}</div></div>`).join('');

    // Visits over the last 30 days, as a simple bar list.
    const max = Math.max(...days.map(d => daily[d]), 1);
    document.getElementById('stats-daily').innerHTML = days.length === 0
      ? '<p class="tab-loading">No visits counted yet.</p>'
      : days.map(d => {
          const count = daily[d];
          const pct = Math.round(count / max * 100);
          return `<div class="module-bar-wrap">
            <span class="module-bar-label" style="width:64px">${d.slice(5)}</span>
            <div class="module-bar-track"><div class="module-bar-fill" style="width:${pct}%"></div></div>
            <span class="module-bar-count">${count}</span>
          </div>`;
        }).join('');

    // Top 20 pages.
    document.getElementById('stats-top').innerHTML = (stats.topPages || []).length === 0
      ? '<p class="tab-loading">No pages counted yet.</p>'
      : stats.topPages.map(p => `
          <div class="row-item">
            <span style="font-family:var(--mono);font-size:12px;color:var(--pewter);width:48px;flex-shrink:0">${p.count}</span>
            <span style="font-family:var(--mono);font-size:13px;color:var(--slate);word-break:break-all">${esc(p.path)}</span>
          </div>`).join('');
  }

  // ── CARD GAPS ──
  function renderCardGaps(search) {
    const items = (search?.unmatchedQueries || []);
    const counts = {};
    items.forEach(q => {
      const k = q.query?.toLowerCase().trim();
      if (k) counts[k] = (counts[k] || 0) + 1;
    });
    const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
    window._cardGaps = sorted;
    renderFilteredCards(sorted);
  }

  function renderFilteredCards(sorted) {
    document.getElementById('cards-gap-list').innerHTML = sorted.length === 0
      ? '<p style="font-family:var(--sans);font-size:14px;color:var(--pewter)">No unmatched queries yet.</p>'
      : sorted.map(([query, count]) => `
          <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-radius:8px;background:rgba(184,80,56,0.03);border:1px solid rgba(184,80,56,0.08);margin-bottom:6px">
            <span style="font-family:var(--serif);font-size:15px;color:var(--slate)">"${query}"</span>
            <span style="font-family:var(--mono);font-size:11px;color:var(--pewter);flex-shrink:0;margin-left:16px">${count}×</span>
          </div>
        `).join('');
  }

  function filterCards() {
    const q = document.getElementById('card-filter').value.toLowerCase();
    const filtered = (window._cardGaps || []).filter(([query]) => query.includes(q));
    renderFilteredCards(filtered);
  }

  function exportCards() {
    const gaps = window._cardGaps || [];
    const csv = 'query,count\n' + gaps.map(([q, c]) => `"${q.replace(/"/g,'""')}",${c}`).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'missing-cards-' + new Date().toISOString().substring(0,10) + '.csv';
    a.click();
  }
</script>