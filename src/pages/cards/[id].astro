---
import Base from '../../layouts/Base.astro';
import { CARDS } from '../../data/cards.js';
import { CARD_RIGHT_NOW } from '../../data/cardRightNow.js';
import { BRAIN_PROCESS, DEFAULT_BRAIN } from '../../data/brainProcess.js';
import { CARD_ACTIVITIES, PATTERN_NAMES } from '../../data/activities.js';
import { KID_BRAIN } from '../../data/kidBrain.js';
import { CARD_TO_TOPIC_GUIDES } from '../../data/cardToTopicGuides.js';

export function getStaticPaths() {
  return CARDS.map(card => ({
    params: { id: card.id },
    props: { card },
  }));
}

const { card } = Astro.props;
const content = CARD_RIGHT_NOW[card.id] || {};
const brain = BRAIN_PROCESS[card.id] || DEFAULT_BRAIN;
const activities = CARD_ACTIVITIES[card.id] || ['breathing'];
const patternData = PATTERN_NAMES[card.id] || null;
const kidBrain = KID_BRAIN[card.id] || null;
const topicGuides = CARD_TO_TOPIC_GUIDES[card.id] || [];

const rightNowText = content.parentNow || content.content || '';

// AI answer engines cite short, self-contained passages. seoTitle is the
// natural-language question form used for the <title> and the FAQ question;
// the H1 keeps the brand-voice title. answerBlock is the quotable lead.
const seoTitle = card.seoTitle || card.title;
const answerBlock = card.answerBlock || '';

// Strip markdown to plain text (keep the words), then cut at a word boundary
// before 155 chars and only add an ellipsis when the text was actually cut.
function stripMarkdown(s) {
  return String(s || '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')          // images
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')        // links -> text
    .replace(/`([^`]+)`/g, '$1')                    // inline code
    .replace(/[*_]{1,3}([^*_]+?)[*_]{1,3}/g, '$1')  // bold / italic -> text
    .replace(/^#{1,6}\s+/gm, '')                    // headings
    .replace(/^>\s?/gm, '')                         // blockquotes
    .replace(/\s+/g, ' ')                           // collapse whitespace
    .trim();
}
function clampWords(s, max) {
  if (s.length <= max) return s;
  const cut = s.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  const base = (lastSpace > 40 ? cut.slice(0, lastSpace) : cut).replace(/[\s.,;:!?-]+$/, '');
  return base + '...';
}
const metaDescription = clampWords(stripMarkdown(rightNowText), 155);
const typeLabel = { moment: 'ADHD parenting moment', parent: 'ADHD parent behaviour', kid: 'ADHD child behaviour' }[card.type];
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": card.title,
  "description": metaDescription,
  "author": { "@type": "Organization", "name": "ADHD Reflect" },
  "publisher": { "@type": "Organization", "name": "ADHD Reflect", "url": "https://adhdreflect.com" },
  "mainEntityOfPage": `https://adhdreflect.com/cards/${card.id}`,
  "datePublished": "2026-05-31",
  "dateModified": "2026-05-31",
  "about": [
    { "@type": "Thing", "name": "ADHD" },
    { "@type": "Thing", "name": "Parenting" },
    { "@type": "Thing", "name": typeLabel }
  ]
};
// FAQPage pairing the question form with the quotable answer, so answer
// engines have a clean question/answer pair to extract and cite.
const faqSchema = answerBlock ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": seoTitle,
    "acceptedAnswer": { "@type": "Answer", "text": answerBlock }
  }]
} : null;
const pageSchema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---
<Base title={seoTitle} description={metaDescription} schema={pageSchema}>

  <!-- SEO: server-rendered content for crawlers (React renders over this) -->
  <article id="seo-content" class="seo-article">
    <h1>{card.title}</h1>
    <p class="seo-type">{typeLabel}</p>
    {answerBlock && <p class="seo-lead">{answerBlock}</p>}
    <section>
      <h2>What to do right now</h2>
      <p>{rightNowText.replace(/\*\*/g, '').slice(0, 500)}</p>
    </section>
    {brain && (
      <section>
        <h2>What your brain just did</h2>
        <h3>Your body</h3>
        <p>{brain.body}</p>
        <h3>Your brain</h3>
        <p>{brain.brain}</p>
        <h3>What this did</h3>
        <p>{brain.effect}</p>
      </section>
    )}
    {kidBrain && (
      <section>
        <h2>What your child is experiencing</h2>
        <h3>Their body</h3>
        <p>{kidBrain.body}</p>
        <h3>Their brain</h3>
        <p>{kidBrain.brain}</p>
        <h3>What they need</h3>
        <p>{kidBrain.need}</p>
      </section>
    )}
  </article>

  <!-- React app renders over the SEO content -->
  <div id="card-viewer-root"
    data-card-id={card.id}
    data-card-type={card.type}
    data-card-title={card.title}
  ></div>

  <script id="pn-data" type="application/json" set:html={JSON.stringify(content.parentNow || '')} />
  <script id="kn-data" type="application/json" set:html={JSON.stringify(content.kidNow || '')} />
  <script id="cn-data" type="application/json" set:html={JSON.stringify(content.content || '')} />
  <script id="bp-data" type="application/json" set:html={JSON.stringify(brain)} />
  <script id="ac-data" type="application/json" set:html={JSON.stringify(activities)} />
  <script id="pd-data" type="application/json" set:html={JSON.stringify(patternData)} />
  <script id="kb-data" type="application/json" set:html={JSON.stringify(kidBrain)} />
  <script id="tg-data" type="application/json" set:html={JSON.stringify(topicGuides)} />

  <script>
    // Hide SEO content once React loads
    const seoEl = document.getElementById('seo-content');
    if (seoEl) seoEl.style.display = 'none';

    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import CardViewer from '../../components/CardViewer.jsx';

    const el = document.getElementById('card-viewer-root');
    const parentNow = JSON.parse(document.getElementById('pn-data').textContent);
    const kidNow = JSON.parse(document.getElementById('kn-data').textContent);
    const content = JSON.parse(document.getElementById('cn-data').textContent);
    const brainProcess = JSON.parse(document.getElementById('bp-data').textContent);
    const activities = JSON.parse(document.getElementById('ac-data').textContent);
    const patternData = JSON.parse(document.getElementById('pd-data').textContent);
    const kidBrain = JSON.parse(document.getElementById('kb-data').textContent);
    const topicGuides = JSON.parse(document.getElementById('tg-data').textContent);

    const root = createRoot(el);
    root.render(createElement(CardViewer, {
      cardId: el.dataset.cardId,
      cardType: el.dataset.cardType,
      title: el.dataset.cardTitle,
      parentNow, kidNow, content, brainProcess, activities, patternData, kidBrain, topicGuides,
    }));
  </script>

</Base>

<style>
  .seo-article {
    max-width: 640px; margin: 0 auto; padding: 40px 24px;
    font-family: var(--serif); color: #6B6358; line-height: 1.7;
  }
  .seo-article h1 { font-size: 28px; font-weight: 300; color: #191714; margin-bottom: 8px; }
  .seo-article h2 { font-size: 20px; font-weight: 400; color: #191714; margin-top: 24px; }
  .seo-article h3 { font-size: 16px; font-weight: 500; color: #4B6B4E; margin-top: 16px; }
  .seo-article p { margin-bottom: 12px; }
  .seo-lead { color: #8A8175; font-style: italic; margin-top: 12px; }
  .seo-type { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: #4A6FA5; text-transform: uppercase; }
</style>

