---
import Base from '../../layouts/Base.astro';
import { CARDS } from '../../data/cards.js';
import { CARD_RIGHT_NOW } from '../../data/cardRightNow.js';
import { CARD_TO_GUIDES } from '../../data/mappings.js';

export function getStaticPaths() {
  return CARDS.map(card => ({
    params: { id: card.id },
    props: { card },
  }));
}

const { card } = Astro.props;
const content = CARD_RIGHT_NOW[card.id] || {};

// Build related guides list with titles
const guideIds = CARD_TO_GUIDES[card.id] || [card.id];
const cardsMap = Object.fromEntries(CARDS.map(c => [c.id, c]));
const relatedGuides = guideIds
  .filter(id => cardsMap[id])
  .map(id => ({ id, title: cardsMap[id].title }));
---
<Base title={card.title} description={`ADHD Reflect: ${card.title}`}>

  <div id="card-viewer-root"></div>

  <script id="parent-now-data" type="application/json" set:html={JSON.stringify(content.parentNow || '')} />
  <script id="kid-now-data" type="application/json" set:html={JSON.stringify(content.kidNow || '')} />
  <script id="content-now-data" type="application/json" set:html={JSON.stringify(content.content || '')} />
  <script id="related-guides-data" type="application/json" set:html={JSON.stringify(relatedGuides)} />

  <script define:vars={{ cardId: card.id, cardType: card.type, title: card.title }}>
    import { createElement } from 'react';
    import { createRoot } from 'react-dom/client';
    import CardViewer from '../../components/CardViewer.jsx';

    const parentNow = JSON.parse(document.getElementById('parent-now-data').textContent);
    const kidNow = JSON.parse(document.getElementById('kid-now-data').textContent);
    const content = JSON.parse(document.getElementById('content-now-data').textContent);
    const relatedGuides = JSON.parse(document.getElementById('related-guides-data').textContent);

    const root = createRoot(document.getElementById('card-viewer-root'));
    root.render(createElement(CardViewer, {
      cardId, cardType, title, parentNow, kidNow, content, relatedGuides,
    }));
  </script>

</Base>

<style is:global>
  .card-content p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--pewter);
    margin-bottom: 14px;
  }
  .card-content p:last-child { margin-bottom: 0; }
  .card-content strong { color: var(--slate); font-weight: 600; }
  .card-content em { font-style: italic; }
  .card-content hr {
    border: none;
    border-top: 1px solid rgba(74,111,165,0.08);
    margin: 20px 0;
  }
</style>

